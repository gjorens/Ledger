#!/bin/bash
# myLedger installer for macOS
#
#   Install:    double-click this file (first time: right-click > Open), or in Terminal:  bash install-mac.command
#   Uninstall:  bash install-mac.command --uninstall     (your ledger.json is never touched)
#
# What it does
#   1. Makes a folder for your ledger data in iCloud Drive:  iCloud Drive > myLedger
#   2. Saves an offline copy of the app in ~/Library/Application Support/myLedger
#   3. Builds  ~/Applications/myLedger.app  with the myLedger icon. Drag it to the Dock if you like.
#      It opens https://gjorens.github.io/Ledger/ in its own window (Chrome, Edge or Brave if installed, otherwise
#      your default browser) and uses the offline copy when there is no internet.

set -euo pipefail

APP_NAME="myLedger"
URL="https://gjorens.github.io/Ledger/"
SUPPORT="$HOME/Library/Application Support/myLedger"
ICLOUD="$HOME/Library/Mobile Documents/com~apple~CloudDocs"
APP="$HOME/Applications/myLedger.app"

if [ "$(uname)" != "Darwin" ]; then echo "This installer is for macOS."; exit 1; fi

if [ "${1:-}" = "--uninstall" ]; then
  rm -rf "$APP" "$SUPPORT"
  echo "Removed $APP and its offline copy. Your ledger file was not touched."
  exit 0
fi

echo "Installing $APP_NAME..."

# 1. data folder
if [ -d "$ICLOUD" ]; then DATA="$ICLOUD/myLedger"; else DATA="$HOME/Documents/myLedger"; echo "iCloud Drive not found, using $DATA instead."; fi
mkdir -p "$DATA" "$SUPPORT" "$HOME/Applications"

# 2. offline copy of the app (best effort)
if curl -fsSL --max-time 20 "$URL" -o "$SUPPORT/index.html.tmp"; then
  mv "$SUPPORT/index.html.tmp" "$SUPPORT/index.html"
else
  rm -f "$SUPPORT/index.html.tmp"
  echo "Could not download the offline copy (no internet?). The app will still work online."
fi

# 3. the app bundle
rm -rf "$APP"
mkdir -p "$APP/Contents/MacOS" "$APP/Contents/Resources"

cat > "$APP/Contents/Info.plist" <<'PLIST'
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>CFBundleName</key><string>myLedger</string>
  <key>CFBundleDisplayName</key><string>myLedger</string>
  <key>CFBundleIdentifier</key><string>com.gjorens.myledger</string>
  <key>CFBundleVersion</key><string>1</string>
  <key>CFBundleShortVersionString</key><string>1.0</string>
  <key>CFBundleExecutable</key><string>myLedger</string>
  <key>CFBundleIconFile</key><string>myLedger</string>
  <key>CFBundlePackageType</key><string>APPL</string>
  <key>LSMinimumSystemVersion</key><string>10.13</string>
  <key>NSHighResolutionCapable</key><true/>
</dict>
</plist>
PLIST

cat > "$APP/Contents/MacOS/myLedger" <<'LAUNCH'
#!/bin/bash
URL="https://gjorens.github.io/Ledger/"
LOCAL="$HOME/Library/Application Support/myLedger/index.html"
if curl -fsI --max-time 3 "$URL" >/dev/null 2>&1; then
  TARGET="$URL"
  # refresh the offline copy in the background
  ( curl -fsSL --max-time 30 "$URL" -o "$LOCAL.tmp" && mv "$LOCAL.tmp" "$LOCAL" ) >/dev/null 2>&1 &
elif [ -f "$LOCAL" ]; then
  TARGET="file://$LOCAL"
else
  TARGET="$URL"
fi
for b in "Google Chrome" "Microsoft Edge" "Brave Browser"; do
  if [ -d "/Applications/$b.app" ] || [ -d "$HOME/Applications/$b.app" ]; then
    open -na "$b" --args --app="$TARGET"
    exit 0
  fi
done
open "$TARGET"
LAUNCH
chmod +x "$APP/Contents/MacOS/myLedger"

# 4. the icon
TMP="$(mktemp -d)"
trap 'rm -rf "$TMP"' EXIT
base64 -D > "$TMP/icon.png" <<'ICON'
