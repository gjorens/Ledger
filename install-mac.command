ICON
SET="$TMP/myLedger.iconset"; mkdir -p "$SET"
for s in 16 32 128 256 512; do
  sips -z $s $s "$TMP/icon.png" --out "$SET/icon_${s}x${s}.png" >/dev/null
  d=$((s*2)); sips -z $d $d "$TMP/icon.png" --out "$SET/icon_${s}x${s}@2x.png" >/dev/null
done
iconutil -c icns "$SET" -o "$APP/Contents/Resources/myLedger.icns"

touch "$APP"
/System/Library/Frameworks/CoreServices.framework/Frameworks/LaunchServices.framework/Support/lsregister -f "$APP" >/dev/null 2>&1 || true

echo
echo "Done."
echo "  App:         $APP  (drag it to the Dock)"
echo "  Your data:   $DATA"
echo
echo "First run: open myLedger, click 'Choose save file...' and save ledger.json in the myLedger folder in iCloud Drive."
echo "Best results: use Chrome, Edge or Brave, which can autosave to that file."
open -R "$APP"
